{
  "name": "vestra",
  "version": "1.0.0",
  "private": true,
  "description": "Vestra - multi-vendor fashion & lifestyle marketplace. Storefront, seller console and admin console on one Next.js App Router codebase.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node --conditions=react-server --env-file=.env.local --import ./scripts/register-loader.mjs scripts/seed.ts",
    "screenshot": "node scripts/screenshot.mjs",
    "smoke": "node scripts/smoke-funnel.mjs",
    "smoke:rbac": "node scripts/smoke-rbac.mjs",
    "verify": "npm run typecheck && npm run lint && npm run build",
    "smoke:admin": "node scripts/smoke-admin.mjs",
    "restart": "powershell -NoProfile -File scripts/restart-server.ps1",
    "audit:a11y": "node scripts/audit-a11y.mjs",
    "audit:contrast": "node scripts/check-contrast.mjs",
    "smoke:shipping": "node scripts/smoke-shipping.mjs",
    "smoke:exchange": "node scripts/smoke-exchange.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.102.2",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "jose": "^6.2.10",
    "lucide-react": "^0.545.0",
    "mongodb": "^6.21.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "recharts": "^3.2.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.11",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.8",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "axe-core": "^4.13.0",
    "eslint": "^9.37.0",
    "eslint-config-next": "16.3.2",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
