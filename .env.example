# ---------------------------------------------------------------- application
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Vestra

# Signing key for session cookies. Rotate per environment; never commit a real one.
AUTH_SECRET=dev-only-insecure-secret-change-me-in-every-real-environment

# --------------------------------------------------------------------- media
# photo     representative Unsplash photography (needs network)
# generated first-party SVG renderer, no external dependency
MEDIA_SOURCE=photo

# ------------------------------------------------------------------ database
# Standalone mongod is fine: nothing in the data layer needs transactions.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=vestra

# ------------------------------------------------------------------- data
# "seed" boots the deterministic demo dataset; "external" targets a real service.
DATA_SOURCE=seed
DATA_DIR=.data
# Regenerate the dataset on next boot regardless of what is on disk.
DATA_RESET=false

# ------------------------------------------------------------------ payments
# mock | razorpay | stripe
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ------------------------------------------------------------------ shipping
# Eshopbox is the fulfilment / logistics provider.
SHIPPING_PROVIDER=eshopbox
ESHOPBOX_BASE_URL=https://api.eshopbox.com
ESHOPBOX_API_KEY=
ESHOPBOX_WORKSPACE=
ESHOPBOX_WEBHOOK_SECRET=
# When unset or when credentials are missing, the adapter runs in simulation
# mode so the whole fulfilment lifecycle is exercisable without live keys.
ESHOPBOX_MODE=simulation

# --------------------------------------------------------------- notifications
EMAIL_PROVIDER=console
SMS_PROVIDER=console
