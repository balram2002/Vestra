# ---------------------------------------------------------------- application
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=VestraWAB

# Signing key for session cookies. Rotate per environment; never commit a real one.
AUTH_SECRET=dev-only-insecure-secret-change-me-in-every-real-environment
# Where this build is deployed: development | staging | production.
# Staging and production refuse to start with a missing secret, a placeholder
# AUTH_SECRET, or a provider that would silently fall back to a mock.
APP_ENV=development
# Lists the demo accounts and their shared password on the sign-in page. Only
# with the demo dataset (npm run seed), never on a real shop.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=false

# --------------------------------------------------------- business identity
# Who runs the shop and how to reach a person: the footer, the contact and
# grievance pages, invoices and the foot of every email. All optional, and
# nothing is invented for an empty one; it is simply not shown.
# NEXT_PUBLIC_, so they are baked in at build time: change one, then redeploy.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_HOURS=
# The registered office, on one line.
NEXT_PUBLIC_BUSINESS_ADDRESS=
# Indian e-commerce rules require a named grievance officer. The email falls
# back to NEXT_PUBLIC_SUPPORT_EMAIL.
NEXT_PUBLIC_GRIEVANCE_OFFICER=
NEXT_PUBLIC_GRIEVANCE_EMAIL=
# Full https:// links to the accounts that exist; leave the rest empty.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=

# --------------------------------------------------------------------- media
# photo     representative Unsplash photography (needs network)
# generated first-party SVG renderer, no external dependency
MEDIA_SOURCE=photo

# ----------------------------------------------------------------- imagekit
# All three set: every upload goes to ImageKit and every <Image> is served from
# it, including remote photography, which ImageKit fetches through its
# web-proxy origin (turn that on for the endpoint in the ImageKit dashboard).
#
# Any of them missing: uploads land on local disk and Next's own optimiser
# serves them. That fallback is deliberate — a clone of this repository runs
# with no accounts to create.
#
# The public two are NEXT_PUBLIC_ because the browser genuinely needs them: an
# upload with real progress goes from the browser straight to ImageKit. The
# private key never leaves the server and only signs ten-minute upload permits.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
# Everything this app uploads lives under one prefix.
IMAGEKIT_FOLDER=/vestra
# Leave false unless the endpoint's web-proxy origin is switched on in the
# ImageKit dashboard (External storage > Web proxy). On, remote images such as
# pasted banner links are delivered by ImageKit too; off, ImageKit answers 404
# for them, so the app serves them directly instead.
NEXT_PUBLIC_IMAGEKIT_WEB_PROXY=false

# -------------------------------------------------------------------- email
# SMTP, because every provider speaks it — SES, Mailgun, Postmark, Resend,
# Google Workspace — so switching provider is a change to these values only.
#
# With no SMTP_HOST, mail is printed to the console AND written as HTML to
# EMAIL_OUTBOX instead of being sent. That is a development convenience, and it
# says so on every message rather than reporting a silent success.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true for implicit TLS on 465; 587 upgrades with STARTTLS on its own.
SMTP_SECURE=false
EMAIL_FROM=VestraWAB <no-reply@vestrawab.example>
EMAIL_REPLY_TO=
EMAIL_OUTBOX=.data/outbox

# ------------------------------------------------------------------ database
# Standalone mongod is fine: nothing in the data layer needs transactions.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=vestra

# ------------------------------------------------------------------- data
# "seed" boots the deterministic demo dataset; "external" targets a real service.
DATA_SOURCE=seed
DATA_DIR=.data
# Regenerate the dataset on next boot regardless of what is on disk.
DATA_RESET=false

# ------------------------------------------------------------------ payments
# mock | razorpay | stripe
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --------------------------------------------------------------- live commerce
# The video provider behind "See it live".
#
#   mock   The default. Serves a demo room on this origin, so the whole flow
#          works with no vendor account. Obvious on screen, so a missing
#          credential can never be mistaken for a working call.
#   zoom   Server-to-Server OAuth. Creates one meeting per session with the
#          shopper muted, camera off, waiting room on and recording disabled.
#   meet   Not implemented. A Meet room cannot be embedded (X-Frame-Options:
#          DENY), so it needs the link-out layout before it is worth wiring.
LIVE_PROVIDER=mock

# Zoom Server-to-Server OAuth app (Zoom Marketplace > Build App > S2S OAuth).
# Scopes needed: meeting:write:admin, meeting:read:admin
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Meeting SDK credentials, for rendering the call INSIDE the page. Without
# these the Zoom adapter still works but reports the room as non-embeddable,
# and the live screen falls back to opening Zoom in a new tab.
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=

# ------------------------------------------------------------------ shipping
# Eshopbox is the fulfilment / logistics provider. See
# https://eshop.gitbook.io/eshopbox-developers
SHIPPING_PROVIDER=eshopbox

# Leave ESHOPBOX_MODE=simulation for local work and CI. The simulated courier
# implements the same interface, and deliberately reproduces the awkward cases
# — unserviceable pincodes, prepaid-only areas, a failed delivery attempt, the
# occasional RTO — so those paths are exercised rather than assumed.
# Set it to "live" (or remove it) once the four credentials below are filled in.
ESHOPBOX_MODE=simulation

# From the custom app you create in the Eshopbox dashboard. The access token is
# minted from the refresh token and cached in-process for its 24h lifetime.
ESHOPBOX_CLIENT_ID=
ESHOPBOX_CLIENT_SECRET=
ESHOPBOX_REFRESH_TOKEN=
# Your account slug. Used as the per-tenant API host and sent as ProxyHost.
ESHOPBOX_WORKSPACE=

# Order and label APIs live on the WMS host; serviceability and webhook
# registration live on https://{ESHOPBOX_WORKSPACE}.myeshopbox.com.
ESHOPBOX_BASE_URL=https://wms.eshopbox.com

# HMAC-SHA256 secret for inbound tracking webhooks. Without it every webhook is
# rejected — this endpoint can mark an order DELIVERED, so it is never trusted
# unsigned.
ESHOPBOX_WEBHOOK_SECRET=

# --------------------------------------------------------------- notifications
EMAIL_PROVIDER=console
SMS_PROVIDER=console
